# Secrets — never commit
.env
Secrets.generated.swift

# Xcode / Swift (project is generated by xcodegen from project.yml)
*.xcodeproj/
build/
# Written by xcodegen from the `info:` block in project.yml
Sources/Info.plist
# Per-clone signing override (see Config/Signing.xcconfig)
Config/Local.xcconfig
# SPM checkouts. The Makefile points -clonedSourcePackagesDirPath outside the
# repo (~/Library/Caches/NotchGram/spm) so a worktree never re-downloads the
# 343 MB TDLibFramework; this covers anyone who overrides SPM_DIR locally.
.spm/
DerivedData/
.build/
*.xcresult/
*.swiftpm

# Runtime & test artifacts
.artifacts/
tdlib-data/
*.log

# macOS
.DS_Store

# Agent tooling (local worktrees, settings)
.claude/
